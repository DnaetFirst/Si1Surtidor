{
  "name": "mi-gasolinera-ciclo-1",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/api", "apps/web"],
  "engines": {"node": ">=22.15.0"},
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @surtidor/api\" \"npm run dev -w @surtidor/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "db:migrate": "npm run db:migrate -w @surtidor/api",
    "db:seed": "npm run db:seed -w @surtidor/api",
    "db:local": "node scripts/local-db.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "test:api": "node --env-file=.env --test --test-concurrency=1 tests/api/*.test.mjs",
    "test:e2e": "playwright test",
    "test": "node scripts/test-stack.mjs",
    "test:architecture": "node --test tests/architecture.test.mjs",
    "test:unit": "npm run build -w @surtidor/api && npm run test:unit -w @surtidor/api",
    "test:isolated:api": "node scripts/test-stack.mjs --api-only",
    "test:isolated:e2e": "node scripts/test-stack.mjs --e2e-only"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "concurrently": "^9.1.2",
    "embedded-postgres": "15.18.0-beta.17",
    "pg": "^8.13.3"
  }
}
